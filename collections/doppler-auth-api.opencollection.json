{
  "opencollection": "1.0.0",
  "info": {
    "name": "Doppler REST ActivityLogs Auth API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve authenticated identity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.doppler.com/v3/me"
          },
          "docs": "Retrieve authenticated identity"
        }
      ]
    }
  ],
  "bundled": true
}